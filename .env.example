# Copiar este archivo como .env.local y completar con valores propios.
# NUNCA subir .env.local al repositorio (ya está en .gitignore).

# URL del proyecto Supabase. Pública: viaja al navegador.
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima. Es pública POR DISEÑO: cualquiera la lee del JS que baja el
# navegador. Lo que protege los datos NO es esconderla, es tener RLS activa
# con políticas explícitas en cada tabla.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de service_role: saltea RLS por completo. SOLO del lado del servidor.
# JAMÁS con prefijo NEXT_PUBLIC_ y jamás importada en un componente de cliente.
SUPABASE_SERVICE_ROLE_KEY=
