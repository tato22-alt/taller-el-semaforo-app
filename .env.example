# Copiar como .env y completar. .env NO se commitea.
#
# Con Vite, TODA variable que empiece con VITE_ se hornea en el bundle y queda
# visible en el navegador. Ahí adentro no va nunca un secreto real.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# La anon/publishable key es pública por diseño: lo que protege los datos es RLS,
# que ya está puesto y verificado en la base (sin sesión, una lectura da 401).
# La service_role saltea RLS por completo: NUNCA acá, NUNCA con prefijo VITE_.
