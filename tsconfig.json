{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],

    /* Sin any, y estricto de verdad. Si un tipo no cierra, el problema es el modelado. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    /* Compila Vite; tsc solo chequea. */
    "noEmit": true,

    /* Los lectores del robot son JavaScript (Apps Script no compila TypeScript). Se chequean igual,
       con JSDoc y // @ts-check; barrido.js no, porque usa los objetos globales de Google. */
    "allowJs": true
  },
  "include": ["src", "robot/lectores/*.js", "robot/*.test.ts", "vite.config.ts"]
}
